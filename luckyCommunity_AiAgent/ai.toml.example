# 复制为 ai.toml 后填写。ai.toml 不进版本库。

[moderation]
# 精判。两个模型都填 flash：同模型下「便宜模型粗筛、强模型精判」没有意义，
# 保留两层只是为了粗筛判 clean 时能直接放行、省掉精判那次调用。
#   deepseek-v4-flash   DeepSeek（当前默认）
#   claude-opus-4-8     Anthropic 官方，漏判代价高时用
model = "deepseek-v4-flash"

# 粗筛。空字符串 = 跳过粗筛，直接精判。
# 只有粗筛判 suspicious 的才上 model。
screen_model = "deepseek-v4-flash"

# 接口地址。留空 = 官方 api.anthropic.com。
base_url = "https://api.deepseek.com/anthropic"

# 结构化输出的实现方式，传给 with_structured_output(method=)。
#   json_schema      DeepSeek 等兼容端点（它们不支持强制 tool_choice）
#   function_calling Anthropic 官方端点
structured_method = "json_schema"

# 三态：整行不写 = 不发送 thinking 参数（官方端点的默认行为）；
# false = 显式关闭思考。
# DeepSeek 上必须写 false：思考内容计入 max_tokens，开着时粗筛的 256
# 会被吃光、输出被截断成非法 JSON，导致每次审核都降级。
thinking = false

# 填 sk-ant-... / sk-... ；留空则改读环境变量
# ANTHROPIC_API_KEY 或 ANTHROPIC_AUTH_TOKEN。
api_key = ""

# ===== 切回官方 Anthropic 的配方 =====
# base_url = ""
# structured_method = "function_calling"
# thinking = true
# model = "claude-opus-4-8"
# screen_model = "claude-haiku-4-5"

max_tokens = 2048
effort = "low"

# 与 docker-compose.yml / Java 共用同一 Redis。不是新中间件。
redis_host = "127.0.0.1"
redis_port = 6380
# redis_password = ""
# 提示词缓存 TTL（秒）；过期后从 PostgreSQL 权威表回源
prompt_cache_ttl_seconds = 300

# 指纹缓存 TTL（秒），默认 7 天
fingerprint_ttl_seconds = 604800
# SimHash 海明距离上限。3 大约对应「话术同、账号/链接不同」
simhash_max_hamming = 3

# Java 读超时 8s；粗筛 2s + 精判 5s 最坏仍留余量
screen_timeout = 2
judge_timeout = 5
screen_accept_confidence = 0.75

# AI 专用 PostgreSQL 账号。prompt_templates / post_vectors 都在 community schema。
database_url = "postgresql://ai_agent:ai_agent_dev@127.0.0.1:5432/community?options=-csearch_path%3Dcommunity,public"
embedding_dimensions = 384
# 可选：OpenAI 兼容 Embedding 地址，例如 http://127.0.0.1:11434/v1。
# 留空时使用本地字符 n-gram 向量，零依赖但语义召回能力较弱。
embedding_base_url = ""
embedding_api_key = ""
embedding_model = "text-embedding-3-small"
retrieval_k = 10
