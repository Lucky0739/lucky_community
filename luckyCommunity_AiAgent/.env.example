# 复制为 .env 后填写。.env 不进版本库。
#
# 模型和 API Key 优先填 luckyCommunity_AiAgent/ai.toml（见 ai.toml.example）。
# 下面这几项会覆盖 ai.toml，适合生产用环境变量注入。
# ANTHROPIC_API_KEY=
# 没设 ANTHROPIC_API_KEY 时会退而读 ANTHROPIC_AUTH_TOKEN。
# MODERATION_MODEL=deepseek-v4-flash
# MODERATION_SCREEN_MODEL=deepseek-v4-flash
# MODERATION_BASE_URL=https://api.deepseek.com/anthropic
# MODERATION_STRUCTURED_METHOD=json_schema
# 三态：不设 = 不发 thinking 参数；false = 显式关闭思考（DeepSeek 必须关）
# MODERATION_THINKING=false
# MODERATION_MAX_TOKENS=2048
# MODERATION_EFFORT=low
#
# 与 docker-compose.yml 的 Redis 一致（端口 6380）。
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6380
# 提示词 Redis 缓存 TTL（秒）；过期后从 PostgreSQL 回源。
# AI_PROMPT_CACHE_TTL=300

# AI 专用 pgvector 连接。prompt_templates / post_vectors 都在 community schema。
# AI_DATABASE_URL=postgresql://ai_agent:ai_agent_dev@127.0.0.1:5432/community?options=-csearch_path%3Dcommunity,public
# AI_EMBEDDING_DIMENSIONS=384
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_RETRIEVAL_K=10

# 服务监听地址。默认只监听回环，避免审核接口暴露到局域网。
AI_HOST=127.0.0.1
AI_PORT=8000
