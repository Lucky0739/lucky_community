<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.community.mapper.PostIndexOutboxMapper">

    <insert id="insert">
        INSERT INTO tb_post_index_outbox (id, topic, payload)
        VALUES (#{id}, #{topic}, #{payload})
    </insert>

    <select id="selectOldest" resultType="com.lucky.community.entity.PostIndexOutbox">
        SELECT id, topic, payload
        FROM tb_post_index_outbox
        ORDER BY id
        LIMIT #{limit}
    </select>

    <delete id="deleteById">
        DELETE FROM tb_post_index_outbox WHERE id = #{id}
    </delete>
</mapper>
