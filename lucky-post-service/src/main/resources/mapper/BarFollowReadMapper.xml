<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.community.mapper.BarFollowReadMapper">

    <select id="selectFollowedBarIds" resultType="long">
        SELECT bar_id
        FROM tb_follow
        WHERE user_id = #{userId}
          AND bar_id IN
        <foreach collection="barIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
