<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.community.mapper.BarMapper">

    <!-- 粉丝数来自 tb_bar_count，与 tb_post_count 同类计数表 -->
    <sql id="BarSelectColumns">
        b.id,
        b.name,
        b.description,
        b.avatar,
        COALESCE(bc.fan_count, 0) AS follow_count,
        b.post_count,
        b.owner_user_id,
        b.status,
        b.create_time,
        b.update_time
    </sql>

    <insert id="insert">
        INSERT INTO tb_bar (id, name, description, avatar, post_count, owner_user_id, status)
        VALUES (#{id}, #{name}, #{description}, #{avatar},
                COALESCE(#{postCount}, 0), #{ownerUserId}, #{status})
    </insert>

    <select id="selectById" resultType="com.lucky.community.entity.Bar">
        SELECT <include refid="BarSelectColumns"/>
        <include refid="BarJoinCount"/>
        WHERE b.id = #{id}
    </select>

    <update id="updateById">
        UPDATE tb_bar
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE tb_bar
        SET status = #{status}, update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <sql id="BarJoinCount">
        FROM tb_bar b
        LEFT JOIN tb_bar_count bc ON bc.bar_id = b.id
    </sql>

    <sql id="PageFilter">
        <include refid="BarJoinCount"/>
        WHERE b.status = #{status}
        <if test="keyword != null and keyword != ''">
            AND b.name LIKE #{keyword} || '%'
        </if>
    </sql>

    <select id="countPage" resultType="long">
        SELECT COUNT(*)
        <include refid="PageFilter"/>
    </select>

    <select id="selectPage" resultType="com.lucky.community.entity.Bar">
        SELECT <include refid="BarSelectColumns"/>
        <include refid="PageFilter"/>
        ORDER BY b.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <sql id="AdminPageFilter">
        <include refid="BarJoinCount"/>
        WHERE 1 = 1
        <if test="status != null">
            AND b.status = #{status}
        </if>
        <if test="keyword != null and keyword != ''">
            AND b.name LIKE #{keyword} || '%'
        </if>
    </sql>

    <select id="countAdminPage" resultType="long">
        SELECT COUNT(*)
        <include refid="AdminPageFilter"/>
    </select>

    <select id="selectAdminPage" resultType="com.lucky.community.entity.Bar">
        SELECT <include refid="BarSelectColumns"/>
        <include refid="AdminPageFilter"/>
        ORDER BY b.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="selectByIds" resultType="com.lucky.community.entity.Bar">
        SELECT <include refid="BarSelectColumns"/>
        <include refid="BarJoinCount"/>
        WHERE b.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectAllIds" resultType="long">
        SELECT id FROM tb_bar
    </select>

    <select id="countByOwnerUserId" resultType="long">
        SELECT COUNT(*)
        FROM tb_bar b
        WHERE b.owner_user_id = #{ownerUserId}
          AND b.status = 1
    </select>

    <select id="selectPageByOwnerUserId" resultType="com.lucky.community.entity.Bar">
        SELECT <include refid="BarSelectColumns"/>
        <include refid="BarJoinCount"/>
        WHERE b.owner_user_id = #{ownerUserId}
          AND b.status = 1
        ORDER BY b.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
