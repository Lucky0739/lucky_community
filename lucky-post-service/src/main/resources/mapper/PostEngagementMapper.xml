<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.community.support.mapper.PostEngagementMapper">

    <select id="countLikesByPostIds" resultType="map">
        SELECT post_id AS "postId", COUNT(*) AS cnt
        FROM tb_thumb
        WHERE post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        GROUP BY post_id
    </select>

    <select id="listLikedPostIds" resultType="long">
        SELECT post_id
        FROM tb_thumb
        WHERE user_id = #{userId}
          AND post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
    </select>

    <select id="countFavoritesByPostIds" resultType="map">
        SELECT post_id AS "postId", COUNT(*) AS cnt
        FROM tb_favorite
        WHERE post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        GROUP BY post_id
    </select>

    <select id="listFavoritedPostIds" resultType="long">
        SELECT post_id
        FROM tb_favorite
        WHERE user_id = #{userId}
          AND post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
    </select>

    <select id="countCommentsByPostIds" resultType="map">
        SELECT post_id AS "postId", COUNT(*) AS cnt
        FROM tb_comment
        WHERE deleted = 0
          AND post_id IN
        <foreach collection="postIds" item="pid" open="(" separator="," close=")">
            #{pid}
        </foreach>
        GROUP BY post_id
    </select>
</mapper>
