<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.user.mapper.RoleMapper">

    <select id="selectByRoleId" resultType="java.lang.Long">
        SELECT id
        FROM tb_role
        WHERE role_code = #{roleCode}
    </select>

    <select id="selectByIds" resultType="com.lucky.user.entity.Role">
        SELECT id, role_name, role_code, description, create_time, update_time
        FROM tb_role
        WHERE id IN
        <foreach collection="list" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
    </select>
</mapper>
