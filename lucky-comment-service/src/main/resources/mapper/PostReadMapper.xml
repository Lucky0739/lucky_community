<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.comment.mapper.PostReadMapper">

    <select id="selectById" resultType="com.lucky.comment.entity.PostRef">
        SELECT id, bar_id, deleted
        FROM tb_post
        WHERE id = #{id}
    </select>

    <select id="selectSummariesByIds" resultType="com.lucky.comment.entity.PostCommentSummary">
        SELECT p.id,
               p.bar_id AS barId,
               b.name AS barName,
               p.title,
               p.content_preview AS contentPreview,
               p.deleted
        FROM tb_post p
        LEFT JOIN tb_bar b ON b.id = p.bar_id
        WHERE p.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
