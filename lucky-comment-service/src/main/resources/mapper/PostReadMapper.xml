<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lucky.comment.mapper.PostReadMapper">

    <select id="selectById" resultType="com.lucky.comment.entity.PostRef">
        SELECT id, bar_id, deleted
        FROM tb_post
        WHERE id = #{id}
    </select>
</mapper>
